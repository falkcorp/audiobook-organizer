{
  // encoding/json/v2 is GA and the default in Go 1.27, so the former
  // GOEXPERIMENT=jsonv2 env and `-tags=goexperiment.jsonv2` build flag are
  // gone; the toolchain sets that build tag itself. Pin the toolchain instead
  // so gopls and the test runner match `make` and CI.
  "go.toolsEnvVars": {
    "GOTOOLCHAIN": "go1.27.1"
  },
  "go.testEnvVars": {
    "GOTOOLCHAIN": "go1.27.1"
  }
}
