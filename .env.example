# file: .env.example
# version: 1.3.0
# guid: 5f6e7d8c-9b0a-4d3c-8e7f-1a2b3c4d5e6f
# last-edited: 2026-10-29

# OpenAI API Configuration (optional, for AI-powered metadata)
OPENAI_API_KEY=your_api_key_here
ABO_BOOKS_AI_ENABLE_AI_PARSING=false
OPENAI_MODEL=gpt-4o-mini
# Override the OpenAI-compatible endpoint (e.g. a local Ollama server). Applies
# to every OpenAI client in the process, including embeddings.
OPENAI_BASE_URL=

# Library folder. docker-compose.yml mounts this host folder read-only at
# /audiobooks in the container. The library root itself is a setting, not an
# environment variable: set it to /audiobooks in the setup wizard or on the
# Settings page. Operators can pin it with --dir or ABO_CORE_LIBRARY_ROOTS.
LIBRARY_HOST_DIR=/path/to/audiobooks

# Where the database lives is set with the --db flag, or ABO_CORE_STORAGE_PATH
# for a binary run. In Docker Compose the ao-data volume at /data holds it.
# Host and port are set with --host / --port.

# Basic-auth gate for the UI. docker-compose.yml passes exactly these three
# into the container when they are set here or in the shell. A gate enabled in
# Settings stays on when they are unset.
ABO_CORE_HTTP_BASIC_GATE_ENABLED=false
ABO_CORE_HTTP_BASIC_GATE_USERNAME=admin
ABO_CORE_HTTP_BASIC_GATE_PASSWORD=changeme

# The variables below are read by the server itself. docker-compose.yml does
# not pass them into the container: to use one with Compose, add it to the
# service's environment list, or set the matching value on the Settings page.

# API protections
ABO_CORE_AUTH_MODE=required
ABO_CORE_HTTP_RATE_LIMIT_PER_MINUTE=100
# Body limits are in bytes (1 MiB and 10 MiB)
ABO_CORE_HTTP_BODY_JSON_MAX_BYTES=1048576
ABO_CORE_HTTP_BODY_UPLOAD_MAX_BYTES=10485760

# Metadata provider overrides (optional)
# ABO_BOOKS_ACOUSTID_API_KEY=

# Fingerprinting / transcription
ABO_BOOKS_FINGERPRINT_FP_PARALLEL_WORKERS=4
ABO_BOOKS_WHISPER_CLIP_CACHE_DIR=
ABO_BOOKS_WHISPER_BATCH_SLEEP_MS=8000

# Dedup / iTunes write-back
ABO_BOOKS_DEDUP_CHROMEM_LAZY=false
ITUNES_WRITEBACK_DRYRUN=false
ABO_BOOKS_ABS_ITUNES_POSITION_BACKFILL_USER_ID=

# ABS auth probe (leave unset to keep the probe disabled)
# ABO_BOOKS_ABS_AUTH_PROBE_ENABLED=

# Retired-versions fixer Apply (leave unset or false to keep the fixer preview-only)
ABO_BOOKS_VERSIONS_RETIRE_VERSIONS_APPLY_ENABLED=false

# Kept-file sweep (leave unset or false to keep it report-only: the nightly trash cleanup
# lists the files it would remove and unlinks nothing)
ABO_BOOKS_VERSIONS_KEPT_SWEEP_APPLY_ENABLED=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=

# Library-list memory warmer
# MB of LIVE heap (what the last GC cycle kept reachable) the warmers may add
# above their post-warmup baseline before they back off. Not an allocation cap:
# the warmer no longer forces GCs and transient garbage is never counted (its
# queries allocate only a few MB each). The resulting ceiling,
# min(baseline + this, 80% of GOMEMLIMIT), is clamped to the memory limit
# because a ~5.9GiB baseline plus the 4096 default would otherwise sit above a
# 9GiB limit and never trip. No clamp applies when GOMEMLIMIT is unset.
ABO_BOOKS_CACHE_LIST_WARMER_HEAP_DELTA_MB=4096
ABO_BOOKS_CACHE_LIST_WARMER_TRICKLE_INTERVAL_MS=10000

# Misc backend tuning
ABO_BOOKS_CACHE_LIBRARY_COUNTS_CACHE_MIN_INTERVAL_SECONDS=600
ABO_BOOKS_SEARCH_BLEVE_DESCRIPTION_MAX_CHARS=500

# Claude automation — production server (used by .claude/skills/server-bootstrap)
AUDIOBOOK_SERVER_IP=
AUDIOBOOK_API_PORT=8484
