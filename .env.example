# file: .env.example
# version: 1.2.0
# guid: 5f6e7d8c-9b0a-4d3c-8e7f-1a2b3c4d5e6f
# last-edited: 2026-08-20

# OpenAI API Configuration (optional, for AI-powered metadata)
OPENAI_API_KEY=your_api_key_here
ENABLE_AI_PARSING=false
OPENAI_MODEL=gpt-4o-mini
# Override the OpenAI-compatible endpoint (e.g. a local Ollama server). Applies
# to every OpenAI client in the process, including embeddings.
OPENAI_BASE_URL=

# Library and database paths (HOST/PORT are set via --host/--port flags, not env)
ROOT_DIR=/path/to/audiobooks
DATABASE_PATH=/data/audiobook-organizer.db

# Basic authentication (set all three to protect the UI)
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=changeme

# API protections
ENABLE_AUTH=true
API_RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
JSON_BODY_LIMIT_MB=1
UPLOAD_BODY_LIMIT_MB=10

# Metadata provider overrides (optional; point at a mock/self-hosted mirror)
ACOUSTID_API_KEY=
AUDIBLE_BASE_URL=
OPENLIBRARY_BASE_URL=
AUDNEXUS_BASE_URL=
GOOGLE_BOOKS_BASE_URL=

# Fingerprinting / transcription
FP_PARALLEL_WORKERS=4
WHISPER_CLIP_CACHE_DIR=
WHISPER_BATCH_SLEEP_MS=8000

# Dedup / iTunes write-back
DEDUP_CHROMEM_LAZY=false
ITUNES_WRITEBACK_DRYRUN=false
ABS_ITUNES_POSITION_BACKFILL_USER_ID=

# ABS auth probe (leave unset to keep the probe disabled)
ABS_AUTH_PROBE=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=

# Library-list memory warmer
LIST_WARMER_HEAP_DELTA_MB=4096
LIST_WARMER_TRICKLE_INTERVAL_MS=10000

# Misc backend tuning
LIBRARY_COUNTS_CACHE_MIN_INTERVAL_SECONDS=600
BLEVE_DESCRIPTION_MAX_CHARS=500

# Claude automation — production server (used by .claude/skills/server-bootstrap)
AUDIOBOOK_SERVER_IP=
AUDIOBOOK_API_PORT=8484
