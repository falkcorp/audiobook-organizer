{
  "name": "audiobook-organizer-web",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "node tests/e2e/check-spec-discovery.mjs && playwright test -c tests/e2e/playwright.config.ts --project chromium --project webkit",
    "test:e2e:check-discovery": "node tests/e2e/check-spec-discovery.mjs",
    "test:e2e:demo": "playwright test -c tests/e2e/playwright.config.ts --project chromium-record",
    "test:e2e:headed": "playwright test -c tests/e2e/playwright.config.ts --project chromium --headed",
    "test:e2e:debug": "playwright test -c tests/e2e/playwright.config.ts --project chromium --debug",
    "test:smoke": "node tests/smoke/routes.mjs",
    "test:ui": "vitest --ui",
    "test:all": "vitest run && playwright test -c tests/e2e/playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "esbuild": "0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "brace-expansion": "^5.0.7",
    "react-is": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "axios": "^1.19.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
