{
  "name": "audiobook-organizer-web",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts --project chromium --project webkit",
    "test:e2e:demo": "playwright test -c tests/e2e/playwright.config.ts --project chromium-record",
    "test:e2e:headed": "playwright test -c tests/e2e/playwright.config.ts --project chromium --headed",
    "test:e2e:debug": "playwright test -c tests/e2e/playwright.config.ts --project chromium --debug",
    "test:ui": "vitest --ui",
    "test:all": "vitest run && playwright test -c tests/e2e/playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "zustand": "^4.4.7"
  },
  "overrides": {
    "minimatch": ">=10.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axios": "^1.18.1",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^23.0.1",
    "playwright": "^1.59.1",
    "prettier": "^3.9.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.9"
  }
}
