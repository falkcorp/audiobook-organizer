{
  "name": "audiobook-organizer-web",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "sh ../scripts/ci/ensure_core_web.sh && node node_modules/@typescript/native/bin/tsc -p . --noEmit && vite build",
    "typecheck": "sh ../scripts/ci/ensure_core_web.sh && node node_modules/@typescript/native/bin/tsc -p . --noEmit",
    "typecheck:ts6": "sh ../scripts/ci/ensure_core_web.sh && tsc6 -p . --noEmit",
    "preview": "vite preview",
    "test": "sh ../scripts/ci/ensure_core_web.sh && vitest",
    "test:coverage": "sh ../scripts/ci/ensure_core_web.sh && vitest --coverage",
    "test:e2e": "node tests/e2e/check-spec-discovery.mjs && playwright test -c tests/e2e/playwright.config.ts --project chromium --project webkit",
    "test:e2e:check-discovery": "node tests/e2e/check-spec-discovery.mjs",
    "test:e2e:demo": "playwright test -c tests/e2e/playwright.config.ts --project chromium-record",
    "test:e2e:headed": "playwright test -c tests/e2e/playwright.config.ts --project chromium --headed",
    "test:e2e:debug": "playwright test -c tests/e2e/playwright.config.ts --project chromium --debug",
    "test:smoke": "node tests/smoke/routes.mjs",
    "test:visual": "node tests/visual/compare-layout.mjs",
    "test:ui": "sh ../scripts/ci/ensure_core_web.sh && vitest --ui",
    "test:all": "sh ../scripts/ci/ensure_core_web.sh && vitest run && playwright test -c tests/e2e/playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mediacore/api-client": "file:../core/web/packages/api-client",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.3.1",
    "esbuild": "0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "brace-expansion": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axios": "^1.21.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "30.0.1",
    "knip": "6.44.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
