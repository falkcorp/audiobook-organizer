{
  "name": "audiobook-organizer-web",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "node tests/e2e/check-spec-discovery.mjs && playwright test -c tests/e2e/playwright.config.ts --project chromium --project webkit",
    "test:e2e:check-discovery": "node tests/e2e/check-spec-discovery.mjs",
    "test:e2e:demo": "playwright test -c tests/e2e/playwright.config.ts --project chromium-record",
    "test:e2e:headed": "playwright test -c tests/e2e/playwright.config.ts --project chromium --headed",
    "test:e2e:debug": "playwright test -c tests/e2e/playwright.config.ts --project chromium --debug",
    "test:ui": "vitest --ui",
    "test:all": "vitest run && playwright test -c tests/e2e/playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "esbuild": "0.28.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^4.4.7"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "brace-expansion": "^5.0.7",
    "react-is": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axios": "^1.19.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^23.0.1",
    "playwright": "^1.59.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.9"
  }
}
