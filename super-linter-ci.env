JF_FILE_PATH=super-linter-ci.env
JF_FILE_VERSION=1.2.0
JF_FILE_GUID=b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e

VALIDATE_ALL_CODEBASE=false
DEFAULT_BRANCH=main
LINTER_RULES_PATH=.
DISABLE_ERRORS=true
LOG_LEVEL=INFO
CREATE_LOG_FILE=true

VALIDATE_BASH=true
VALIDATE_BASH_EXEC=true
VALIDATE_DOCKERFILE_HADOLINT=true
VALIDATE_EDITORCONFIG=true
VALIDATE_ENV=true
VALIDATE_GITHUB_ACTIONS=true
VALIDATE_GO=true
VALIDATE_HTML=true
VALIDATE_JAVASCRIPT_ES=true
VALIDATE_JAVASCRIPT_PRETTIER=true
VALIDATE_JSX=true
VALIDATE_TYPESCRIPT_ES=true
VALIDATE_TYPESCRIPT_PRETTIER=true
VALIDATE_TSX=true
VALIDATE_JSON=true
VALIDATE_JSONC=true
VALIDATE_MARKDOWN=true
VALIDATE_PROTOBUF=true
VALIDATE_PYTHON_BLACK=true
VALIDATE_PYTHON_PYLINT=true
VALIDATE_PYTHON_FLAKE8=true
VALIDATE_PYTHON_ISORT=true
VALIDATE_PYTHON_RUFF=true
VALIDATE_RUST_2021=true
VALIDATE_RUST_CLIPPY=true
VALIDATE_SHELL_SHFMT=true
VALIDATE_YAML=true
VALIDATE_XML=true

FILTER_REGEX_EXCLUDE=.*(vendor|node_modules|\.git|\.vscode|\.pb\.go|_pb2\.py|\.generated\.|\.min\.|\.map|coverage|\.tmp|dist|build).*

# JAVASCRIPT_ES_CONFIG_FILE / TYPESCRIPT_ES_CONFIG_FILE dropped 2026-08-18: this
# repo's flat config lives at web/eslint.config.mjs, NOT the repo root, and a
# *_CONFIG_FILE value is resolved against LINTER_RULES_PATH. eslint discovers a
# flat config from the linted file's own directory, so auto-discovery is correct
# here. The real JS/TS gate is `npm run lint` in the frontend-lint-build job.
PYTHON_BLACK_CONFIG_FILE=pyproject.toml
PYTHON_PYLINT_CONFIG_FILE=.pylintrc
MARKDOWN_CONFIG_FILE=.markdownlint.json
YAML_CONFIG_FILE=.yamllint
RUST_CLIPPY_CONFIG_FILE=clippy.toml

# ── Config resolution (fixed 2026-08-18) ────────────────────────────────────
# Super Linter resolves every *_CONFIG_FILE as a FILENAME relative to
# LINTER_RULES_PATH, not as a repo-root path. This file previously carried
# values like `.github/linters/.golangci.yml`, which resolved to
# `.github/linters/.github/linters/.golangci.yml` AND named four files that did
# not exist at all. LINTER_RULES_PATH is now the repo root and every value below
# is a bare filename that exists there.
#
# DISABLE_ERRORS=true is deliberate: Super Linter reports every finding but exits
# 0. Blocking Go lint is golangci-lint's job in the go-lint CI job; this pass is
# advisory breadth (Markdown, YAML, shell, JS) and must never block a PR.
