.claude/settings.local.json
.claude/worktrees/
.claude/state/
.remember/
.superpowers/
.claude/scheduled_tasks.lock
.claude/notes/

# Build output
bin/
dist/
temp_out/

# Logs
logs/
*.log

# Temporary files
*.tmp

# Database files (local development)
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.pebble/
audiobooks.pebble/
*.nutsdb/

# Bleve search index (local dev)
*.bleve/
library.bleve/

# Bootstrap token (auth credential, do not commit)
.bootstrap-token

# Startup read-only API key (auth credential, do not commit)
.readonly-key

# API token files (auth credentials, do not commit)
.api-token
*.api-token
.claude/.api-token

# Worktree-specific credentials (per-branch user/pass, do not commit)
.claude/.credentials/

# Backup files
*.bak
.audiobook-backups/

# Encryption keys
.encryption_key
web/test-results/

# Demo artifacts (generated by E2E tests)
demo_artifacts/

# iTunes test data (personal library metadata - DO NOT COMMIT)
testdata/itunes/*.xml
testdata/itunes/*.itdb
testdata/itunes/*.itl
testdata/itunes/*.tmp
testdata/itunes/sentinel
!testdata/itunes/README.md
!testdata/itunes/create_test_subset.go

# Production TLS certificates (DO NOT COMMIT - snake oil certs are in certs/ for development)
*.pem
prod-*.crt
prod-*.key
production.crt
production.key
test-reports/go-coverage.html
copilot_fix_tasks_*.json
summary_report_*.md
failure_analyses_*.json
test_results.txt
test-results.txt

# Git worktrees
.worktrees/
worktrees/
web/tests/e2e/playwright-report/index.html
web/tests/e2e/playwright-report/
web/tests/e2e/playwright-report/**/*

# Root-level Playwright report (generated by web/tests/e2e runs from repo root)
/playwright-report/

# Dedup benchmark output (large raw API responses)
testdata/dedup-bench/

# mTLS bridge certificates and config
.mtls/

# Static libraries for native taglib CGO build (built locally)
third_party/taglib/lib/*.a
# Private reports with local file paths — never commit these
docs/private/
docs/reports/

# stray binary from cmd/itunes-sync-tests build
/itunes-sync-tests
/itl-diff
/verify-suite

