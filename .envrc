# file: .envrc
# version: 2.0.0
# guid: f7a8b9c0-d1e2-3456-7890-abcdef123456
# last-edited: 2026-09-01

# Same toolchain pin as the Makefile, for bare `go` commands and editors under
# direnv. GOTOOLCHAIN=auto never steps DOWN, so without this a newer local Go
# would build a binary that differs from what `make` and CI produce.
# encoding/json/v2 is GA and the default in Go 1.27 — no GOEXPERIMENT needed.
export GOTOOLCHAIN=go1.27.1
