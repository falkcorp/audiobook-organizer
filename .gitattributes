*.m4b filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# Visual-regression goldens are ~2KB each and must be a readable PNG on EVERY
# checkout, including CI runners that do not fetch LFS. The blanket `*.png`
# LFS rule above was catching them, so what landed in the working tree on CI
# was an LFS POINTER FILE, and Playwright reported
# "Could not decode expected image as PNG" -- which reads like a corrupt
# golden rather than a missing LFS fetch. These three files are the only PNGs
# in the repo; LFS exists here for the audio fixtures, not for them.
web/tests/e2e/**/*.png !filter !diff !merge -text
