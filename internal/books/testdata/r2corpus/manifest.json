{
  "_header": {
    "file": "internal/books/testdata/r2corpus/manifest.json",
    "version": "1.0.0",
    "guid": "d808d644-1404-4e9f-b549-f20bbbb939bd",
    "last-edited": "2026-11-10"
  },
  "r0_tag": "v0.223.0",
  "r0_binary_sha256": "6f33d9dd7e41c2e43c3aa80342ed2c5b940df749ae6fdd6773bce9053837dc6f",
  "written_at": "2026-11-10T10:07:51Z",
  "credentials": "every credential in this corpus is a generated fixture value (invariant 2); API keys in answer files are <api-key:NAME> placeholders",
  "boot": {
    "workdir": "/tmp/r2corpus",
    "cwd": "/tmp/r2corpus/stage1/db",
    "argv": [
      "<r0-binary>",
      "serve",
      "--config",
      "/tmp/r2corpus/home/.audiobook-organizer.yaml",
      "--db",
      "/tmp/r2corpus/stage1/db/audiobooks.pebble",
      "--dir",
      "/tmp/r2corpus/stage1/library",
      "--playlists",
      "/tmp/r2corpus/stage1/playlists",
      "--host",
      "127.0.0.1",
      "--port",
      "18484",
      "--workers",
      "2"
    ],
    "env": {
      "HOME": "/tmp/r2corpus/home",
      "ABK_STATE_DIR": "/tmp/r2corpus/stage1/state",
      "TZ": "UTC",
      "ACOUSTID_API_KEY": "fixture-acoustid-key-lucius",
      "SCHEDULED_LIBRARY_SCAN_ON_STARTUP": "false",
      "SCHEDULED_DEDUP_REFRESH_INTERVAL": "720",
      "MAINTENANCE_WINDOW_START": "2",
      "DELUGE_WEB_URL": "http://deluge.invalid:8112",
      "DELUGE_WEB_PASSWORD": "fixture-deluge-password-oracle",
      "ABS_API_ENABLED": "true",
      "ABS_AUTH_MODES": "jwt",
      "ABS_JWT_SECRET": "fixture-abs-jwt-secret-for-the-r2-corpus-only-0001"
    },
    "files": {
      "/tmp/r2corpus/home/.audiobook-organizer.yaml": {
        "log_level": "info",
        "concurrent_scans": 2,
        "scan_on_startup": false,
        "auto_update_enabled": false,
        "write_startup_readonly_key": false
      },
      "/tmp/r2corpus/stage1/db/config.yaml": {
        "hardcover_api_token": "fixture-hardcover-token-oracle",
        "enable_ai_parsing": false
      }
    },
    "container_hostname": "r2corpus"
  },
  "stage1": [
    {
      "case": "admin.bootstrap",
      "family": "user, apikey, setting:bootstrap_*",
      "step": "M3",
      "how": "bootstrap token exchange: first admin `admin` + an all-scope admin-owned key",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "users.invited",
      "family": "user, invite, session",
      "step": "M3",
      "how": "invites for every seeded role, accepted (each sets a session)",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "users.disabled",
      "family": "user (status inactive)",
      "step": "M3",
      "how": "deactivate one viewer",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "invites.open",
      "family": "invite",
      "step": "M3",
      "how": "an invite left open and one revoked",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "sessions.web",
      "family": "session",
      "step": "M3",
      "how": "web logins (remember_me) for several users",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "apikeys.variants",
      "family": "apikey, idx:apikey",
      "step": "M3",
      "how": "scoped, empty-scope, every-atom, admin-owned-for-another-user, fp-worker keys",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "config.stored",
      "family": "setting:config_blob, setting:<secret> (encrypted)",
      "step": "M2",
      "how": "PUT /api/v1/config: plain keys of every class and the four IsSecret secrets",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "config.layers",
      "family": "config.yaml (gap-fill), env, viper YAML",
      "step": "M2",
      "how": "operator layers: gap-fill config.yaml beside the store, env per layer, viper YAML",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "integrations.blob",
      "family": "setting:config_blob (integration fields), webhook plugin settings",
      "step": "M6",
      "how": "integration fields and the webhook plugin through PUT /api/v1/config, then a restart",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "import.roots",
      "family": "importpath, book, book_file, author, ... (the library)",
      "step": "M6",
      "how": "an import root added through the API; its auto-scan imports the fixture library",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "books.organized",
      "family": "book, book_file (organized copies under root_dir), undo journal",
      "step": "books",
      "how": "every imported book organized into root_dir (copy strategy); ABS serves root_dir",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "tasks.schedules",
      "family": "setting: scheduler task config, maintenance window",
      "step": "M4",
      "how": "task schedules edited through the task routes; maintenance window config",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "runs.succeeded",
      "family": "opv2:run (succeeded), op history",
      "step": "M4",
      "how": "a library scan run that succeeds (takes the scan stand-down while it runs)",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "runs.failed",
      "family": "opv2:run (failed)",
      "step": "M4",
      "how": "a library scan of a missing folder (fails)",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "runs.canceled",
      "family": "opv2:run (canceled)",
      "step": "M4",
      "how": "a run started and canceled through DELETE /operations/v2/:id",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "runs.task",
      "family": "opv2:run (scheduled task run), task last_run clock",
      "step": "M4",
      "how": "a scheduled task run on demand through POST /tasks/:name/run",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "books.playlists",
      "family": "playlist",
      "step": "books",
      "how": "a static playlist with two books and a smart playlist",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "books.reading",
      "family": "user book state (status overrides)",
      "step": "books",
      "how": "reading status set through the web API for two users",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "books.abs",
      "family": "abs_sess:, ABS progress, bookmarks, playback sessions",
      "step": "books",
      "how": "ABS logins, a play/sync/close session, progress and a bookmark through the ABS API",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "syslog.normal",
      "family": "syslog:, book (auto-scanned), opv2:run (library.scan from the watcher)",
      "step": "M5",
      "how": "a book dropped into the watched import root: the auto-scan watcher logs to syslog:",
      "store": "internal/books/testdata/r2corpus/stage1"
    },
    {
      "case": "runs.paused",
      "family": "operations pause marker",
      "step": "M4",
      "how": "the executor paused through POST /operations/pause and left paused at the stop",
      "store": "internal/books/testdata/r2corpus/stage1"
    }
  ],
  "not_writable_by_r0_api": [
    {
      "family": "oauthid:",
      "step": "M3",
      "why": "OAuth identities are created only by an SSO sign-in against an external provider"
    },
    {
      "family": "inviteallow:",
      "step": "M3",
      "why": "the invite allow-list is written only when an invite delivered by email is consumed"
    },
    {
      "family": "aijob*",
      "step": "M6",
      "why": "AI jobs are created only through the OpenAI Batch API (no fake endpoint in R0)"
    },
    {
      "family": "opv2:run (running, stopping, queued)",
      "step": "M4",
      "why": "a clean stop drains or interrupts open runs; F2-13 writes these states"
    }
  ],
