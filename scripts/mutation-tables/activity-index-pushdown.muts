# Mutation table for the activity secondary-index limit pushdown.
#
# Format: NAME | FILE | PERL_EXPRESSION      (see scripts/mutation-matrix.sh)
# Run:
#   scripts/mutation-matrix.sh \
#     --pkg ./internal/database/ \
#     --table scripts/mutation-tables/activity-index-pushdown.muts
#
# WHAT THIS TABLE IS FOR. queryByIndexPrefixPaged returns a page AND a `total`,
# and `total` is serialized to the UI's pager with no error channel anywhere. A
# wrong count here is the exact shape of defect this repo keeps shipping: a 200
# OK with a plausible wrong number. So the mutations below are aimed at the
# COUNT and the ORDER, not at whether the function returns rows at all — any
# fixture notices the latter, and none of the defects an adversarial review
# found in this code would have been caught by that.
#
# The `total--` corrections (M07-M09) get one mutation each rather than one for
# the group, because each is a separate arithmetic claim about a separate
# population (pruned / undecodable / foreign) and a fixture can easily contain a
# row for one and none for the others.
#
# M18 IS A KNOWN EQUIVALENT MUTANT and is expected to SURVIVE. Removing
# pit.Next() leaves the merge correct: the next iteration re-seeks whenever the
# iterator is not already past the target, so dropping the advance costs a SeekGE
# and changes no answer. It is listed rather than omitted so that nobody
# rediscovers it and "fixes" it with a test asserting an implementation detail.
# Confirm it stays survived; do not chase it.
#
# A SECOND EQUIVALENT MUTANT WAS FOUND AND THEN DELETED RATHER THAN DOCUMENTED.
# The page loop's counter used to be called `rank` and was also incremented once
# per appended row. Adding a further increment survived — because the counter is
# read in exactly one place, `< f.Offset`, and by the time a row can be appended
# it has already reached the offset and can never fall back under it. That is
# what a dead store looks like from the outside. It is now named `skipped`, is
# incremented only where it is read, and M11 tests its one real boundary instead.
#
# ANCHOR MUTATIONS ON CODE, NOT ON COMMENTS. M10 used to quote a sentence from a
# comment that was never in the file, so it silently reported NOT-APPLIED. A
# mutation anchored on prose breaks the next time someone rewords the prose, and
# the breakage LOOKS like a table typo rather than what it is — a mutation that
# stopped being run. Every pattern below quotes executable text.

# ── the existence merge that defines `total` ─────────────────────────────────
M01 count every ref, alive or not | internal/database/pebble_activity_store.go | s/if pit\.Valid\(\) && bytes\.Equal\(pit\.Key\(\), k\) \{/if true {/
M02 never mark anything alive | internal/database/pebble_activity_store.go | s/alive\[bucket\.pos\[i\]\] = true/_ = i/
M03 total ignores the merge result | internal/database/pebble_activity_store.go | s/\tlive\+\+\n/\t\n/

# ── the reverse scan the newest-first order rests on ─────────────────────────
M04 scan the index forward instead of backward | internal/database/pebble_activity_store.go | s/for iter\.Last\(\); iter\.Valid\(\); iter\.Prev\(\) \{/for iter.First(); iter.Valid(); iter.Next() {/

# ── the two scan-time rejections that keep the two totals equal ──────────────
M05 accept a key that only PREFIX-matches the id | internal/database/pebble_activity_store.go | s/if !pactIndexKeyNamesExactly\(iter\.Key\(\), prefix\) \{/if false {/
M06 accept a ref that cannot become a primary key | internal/database/pebble_activity_store.go | s/if ti < 0 \{\n\t\t\tcontinue\n\t\t\}/if ti < -1 {\n\t\t\tcontinue\n\t\t}/

# ── the three per-population corrections to `total` ──────────────────────────
M07 pruned-between-passes row stays in total | internal/database/pebble_activity_store.go | s/\t\t\t\/\/ Deleted between markLiveRefs and now \(a concurrent prune\)\. The\n(.*\n)*?\t\t\ttotal--\n/\t\t\t/
M08 undecodable row stays in total | internal/database/pebble_activity_store.go | s/\t\t\ts\.decodeFailures\.Add\(1\)\n\t\t\ttally\.record\(primaryKey, jsonErr\)\n\t\t\ttotal--\n/\t\t\ts.decodeFailures.Add(1)\n\t\t\ttally.record(primaryKey, jsonErr)\n/
M09 foreign row in the page stays in total | internal/database/pebble_activity_store.go | s/if !matchesFilter\(entry, f\) \{\n\t\t\ttotal--\n/if !matchesFilter(entry, f) {\n/

# ── the page is taken by rank over SURVIVORS, not by index position ──────
M10 an orphaned ref consumes an offset slot | internal/database/pebble_activity_store.go | s/\t\tif !alive\[i\] \{\n\t\t\tcontinue\n\t\t\}/\t\tif !alive[i] {\n\t\t\tskipped++\n\t\t\tcontinue\n\t\t}/
M11 off-by-one in the offset skip | internal/database/pebble_activity_store.go | s/if skipped < f\.Offset \{/if skipped <= f.Offset {/

# ── the ordering contract both paths are held to ─────────────────────────────
M12 drop the tie-break, leaving ties unordered | internal/database/pebble_activity_store.go | s/\t\treturn strings\.Compare\(b\.entryID, a\.entryID\)/\t\treturn 0/
M13 tie-break ascending instead of descending | internal/database/pebble_activity_store.go | s/\t\treturn strings\.Compare\(b\.entryID, a\.entryID\)/\t\treturn strings.Compare(a.entryID, b.entryID)/
M14 sort oldest-first instead of newest-first | internal/database/pebble_activity_store.go | s/\t\tif c := b\.entry\.Timestamp\.Compare\(a\.entry\.Timestamp\); c != 0 \{/\t\tif c := a.entry.Timestamp.Compare(b.entry.Timestamp); c != 0 {/

# ── the write-time guard that keeps key order == chronological order ─────────
M15 admit pre-epoch timestamps into the keyspace | internal/database/pebble_activity_store.go | s/if e\.Timestamp\.UnixNano\(\) < 0 \{/if false {/

# ── the eligibility gate that decides whether the pushdown runs at all ───────
#
# M16 WAS REPORTED SURVIVED FOR TWO DAYS AND THE REPORT WAS FALSE. Until
# 2026-08-30 mutation-matrix.sh rewrote `\x7c` into a bare `|` before handing the
# expression to perl, which turned this pattern's `||` into ALTERNATION WITH TWO
# EMPTY BRANCHES. It matched the zero-length string at offset 0, prepended a tab
# and a newline to line 1, left the gate byte-identical, still changed the file
# enough to satisfy the "did it apply" guard, compiled, and passed. The entry
# below is unchanged; the harness was fixed and grew guard 5 (a one-byte sentinel
# preflight) so a zero-width pattern is rejected instead of scored.
#
# 2026-08-30 (later the same day) M16 WAS RE-ANCHORED. The gate was rewritten
# from a deny-list of undecidable fields into an allow-list walk over
# ActivityFilter, which deleted the exact `if f.Type != ""` line M16 quoted. Left
# alone, M16 would have reported NOT-APPLIED — and this table's own history is
# that a mutation which stops running is indistinguishable from one that
# survives. It now quotes the refusal inside the field walk, which is the same
# claim ("an undecidable predicate must not be pushed down") against the new
# shape. M19 and M20 guard the two ways the new shape can silently fail open.

M16 push down a filter the index cannot decide | internal/database/pebble_activity_store.go | s/\t\tif pactFilterFieldCarriesPredicate\(v\.Field\(i\)\) \{\n\t\t\treturn false\n\t\t\}/\t\t_ = v.Field(i)/
M17 push down on an unknown index family | internal/database/pebble_activity_store.go | s/\t\t\/\/ An unknown index family: neither id predicate can be justified by\n\t\t\/\/ construction, so refuse rather than guess\.\n\t\treturn false/\t\treturn true/


# ── the allow-list's two silent fail-open modes ──────────────────────────
# M19 is the nil-vs-empty slice trap. reflect.Value.IsZero on a slice is IsNil,
# so swapping len() for it makes a non-nil EMPTY slice (`"tags": []`) read as a
# live predicate. Nothing returns a wrong ANSWER — the fast path is just quietly
# lost for those callers, which is why only a test that asserts eligibility for
# an empty slice can see it.
M19 treat a non-nil empty slice as a live predicate | internal/database/pebble_activity_store.go | s/\t\treturn v\.Len\(\) > 0/\t\treturn !v.IsNil()/
# M20 bypasses the allow-list entirely, which is the fail-OPEN behaviour of the
# deny-list this gate replaced: every field counts as decidable and every filter
# is pushed down.
M20 treat every filter field as decidable | internal/database/pebble_activity_store.go | s/\t\tif pactPushdownDecidable\[t\.Field\(i\)\.Name\] \{/\t\tif true {/

# ── known equivalent mutant, listed so nobody rediscovers it ─────────────
M18 drop the merge iterator advance (EQUIVALENT - expect SURVIVED) | internal/database/pebble_activity_store.go | s/\t\t\t\tpit\.Next\(\)\n//
