# file: scripts/mutation-tables/catalog-harvest-rules.muts
# version: 1.5.0
# guid: 4c1e7a93-8b2d-4f60-a5e9-2d6b0f8c3a71
# last-edited: 2026-10-01
#
# Mutation table for the author-catalog P1 rules: edition grouping, sequence
# parsing, author disambiguation, and the stale/cap/resume decisions of the
# harvest. Format: NAME | FILE | PERL_EXPRESSION (see scripts/mutation-matrix.sh).
# Run:
#   scripts/mutation-matrix.sh --pkg ./internal/catalog/ \
#     --table scripts/mutation-tables/catalog-harvest-rules.muts
#
# Each line is a lie the catalog could tell while still compiling: a reversed
# range read as a position, a title-only group, a homonym's catalog kept, a
# capped or partial listing marking the unlisted tail stale.
#
# M28 deletes the short verdict but keeps the return: turning the case off
# entirely loops forever on an empty page and hangs the suite.
#
# M19 removes BOTH preserved fields: removing only the group id is an
# equivalent mutant while the old group key is kept, because the key maps back
# to the same id.

M01 reversed-range-accepted | internal/catalog/sequence.go | s/errB != nil \x7c\x7c b < a/errB != nil/
M02 range-branch-skipped | internal/catalog/sequence.go | s/seqRangeRe\.FindStringSubmatch\(t\); m != nil \{/seqRangeRe.FindStringSubmatch(t); m != nil && false {/
M03 title-only-group | internal/catalog/normalize.go | s/if id == "" \x7c\x7c t == "" \{/if t == "" {/
M04 group-ignores-title | internal/catalog/normalize.go | s/return id \+ "\x7c" \+ t/return id/
M05 markers-not-stripped | internal/catalog/normalize.go | s/return authorjunk\.FoldKey\(StripEditionMarkers\(title\)\)/return authorjunk.FoldKey(title)/
M06 group-name-unfolded | internal/catalog/normalize.go | s/id := AuthorNameKey\(primaryAuthorName\)/id := "name:" + primaryAuthorName/
M07 homonym-kept | internal/catalog/disambig.go | s/if asin == "" \x7c\x7c len\(res\.AuthorASINs\) == 0 \{/if true {/
M08 coauthor-asin-taken | internal/catalog/disambig.go | s/if a\.ASIN == "" \x7c\x7c authorjunk\.FoldKey\(a\.Name\) != fold \{/if a.ASIN == "" \x7c\x7c fold == "-" {/
M09 conflict-never-set | internal/catalog/disambig.go | s/res\.Conflict = len\(res\.AuthorASINs\) > 1\n\treturn res, nil/res.Conflict = false\n\treturn res, nil/
M10 lookup-even-when-listed | internal/catalog/disambig.go | s/if p, ok := fetched\[owned\]; ok \{/if p, ok := fetched[owned]; ok && false {/
