# Mutation table for the organizer Landing contract (PR #3046).
#
# Format: NAME | FILE | PERL_EXPRESSION      (see scripts/mutation-matrix.sh)
# Run:
#   scripts/mutation-matrix.sh \
#     --pkg ./internal/organizer/ \
#     --table scripts/mutation-tables/organize-landing.muts
#
# WHAT THIS TABLE IS FOR. Every mutation below is a way the organize path can
# report success while pointing a row at another book's audio, deleting a file
# it did not write, or replacing a file that was already at the destination.
# None of them is a syntax-tree flip gremlins would generate; each is a
# plausible "simplification" a later edit could make.

# Rows follow the landing, never a guess.
M01 unlanded-row-gets-empty-path | internal/organizer/service.go | s/\tif !ok \x7c\x7c dstPath == "" \{\n/\tif ok && dstPath == "" {\n/
# Fail-closed gate for a single-file landing on a multi-row book.
M02 multirow-single-landing-accepted | internal/organizer/service.go | s/\tif !isDir && len\(bookFiles\) > 1 \{\n/\tif !isDir && len(bookFiles) > 1000 {\n/
# Rollback scope.
M03 rollback-removes-whole-directory | internal/organizer/organizer.go | s/\t\tif err := os\.Remove\(p\); err != nil && !errors\.Is\(err, fs\.ErrNotExist\) \{\n\t\t\tleftover = append\(leftover, p\)/\t\tif err := os.RemoveAll(filepath.Dir(p)); err != nil \&\& !errors.Is(err, fs.ErrNotExist) {\n\t\t\tleftover = append(leftover, p)/
M04 rollback-ignores-containment | internal/organizer/organizer.go | s/\t\tif p == "" \x7c\x7c ensureUnderRoot\(p, root\) != nil \{\n/\t\tif p == "" {\n/
M05 adopted-single-file-marked-created | internal/organizer/service.go | s/\tif mode != "" \{\n\t\tl\.Created = \[\]string\{newPath\}\n/\tif mode != "" \x7c\x7c true {\n\t\tl.Created = []string{newPath}\n/
# Strategy decision.
M06 multirow-file-path-routed-single | internal/organizer/service.go | s/\tisDir := len\(bookFiles\) > 1\n/\tisDir := len(bookFiles) > 1000\n/
# Exclusive publish.
M07 finalize-uses-rename | internal/organizer/saferename.go | s/\tif err := os\.Link\(src, dst\); err != nil \{\n/\tif err := os.Rename(src, dst); err != nil {\n/
M08 reorganize-uses-saferename | internal/organizer/service.go | s/\tif err := moveExclusive\(oldPath, targetPath\); err != nil \{\n/\tif err := safeRename(oldPath, targetPath); err != nil {\n/
# Temp naming and stranded-temp resume.
M09 rename-temp-shares-name | internal/organizer/pipeline.go | s/\treturn target \+ TmpRenameSuffix \+ "-" \+ tempNonce\(\)\n/\treturn target + TmpRenameSuffix\n/
M10 stranded-glob-unescaped | internal/organizer/pipeline.go | s/filepath\.Glob\(globEscape\(legacy\) \+ "-\*"\)/filepath.Glob(legacy + "-*")/
M11 ambiguous-stranded-picks-first | internal/organizer/pipeline.go | s/\t\t\tcase 1:\n\t\t\t\tslog\.Warn\("RenameFiles resuming/\t\t\tdefault:\n\t\t\t\tslog.Warn("RenameFiles resuming/; s/\t\t\tdefault:\n\t\t\t\tmsg := fmt\.Sprintf\("%d stranded/\t\t\tcase -1:\n\t\t\t\tmsg := fmt.Sprintf("%d stranded/
# copyFile temp collision must not look like a taken destination.
M12 nonce-collision-is-errexist | internal/organizer/organizer.go | s/return fmt\.Errorf\("temp file %s for %s already exists \(nonce collision with another writer\): %v", tempPath, dst, err\)/return fmt.Errorf("temp file %s for %s already exists (nonce collision with another writer): %w", tempPath, dst, err)/
# A directory landing is all-or-nothing: an unlanded file must fail the book.
M13 partial-directory-landing-kept | internal/organizer/organizer.go | s/\tif len\(unlanded\) > 0 \{\n\t\tleftover := unlinkCreated\(created, targetDir, targetDir\)/\tif len(unlanded) > 0 \&\& false {\n\t\tleftover := unlinkCreated(created, targetDir, targetDir)/
# A stranded temp with no recorded size must not be resumed.
M14 stranded-temp-no-size-resumed | internal/organizer/pipeline.go | s/\tif entry\.ExpectedSize <= 0 \{\n\t\treturn fmt\.Sprintf\("stranded temp %s for %s \(source %s is gone\) cannot be verified/\tif entry.ExpectedSize < 0 {\n\t\treturn fmt.Sprintf("stranded temp %s for %s (source %s is gone) cannot be verified/
# A stranded temp whose size disagrees with the row must not be resumed.
M15 stranded-temp-size-ignored | internal/organizer/pipeline.go | s/\tif info\.Size\(\) != entry\.ExpectedSize \{/\tif info.Size() != entry.ExpectedSize \&\& false {/
# A symlink source must take the rename path, not the link path.
M16 symlink-source-takes-link-path | internal/organizer/saferename.go | s/\tif info\.IsDir\(\) \x7c\x7c info\.Mode\(\)&fs\.ModeSymlink != 0 \{/\tif info.IsDir() {/

# An in-place landing must be refused by CreateOrganizedVersion itself, not
# only by the callers that happen to branch on InPlace first (#3051 review M1).
M19 create-version-accepts-inplace | internal/organizer/service.go | s/if landing\.InPlace \{\n\t\treturn nil, fmt\.Errorf\("organize: landing for/if false {\n\t\treturn nil, fmt.Errorf("organize: landing for/
