#
# The mediacore.integrations scope's series (05-metadata M1.8):
# family<TAB>type<TAB>labels, checked by metricstest.AssertSeries in
# TestIntegrationsSeries_Golden. The two gauges are observed from the
# Registry's instance snapshot; health_probe carries no instance label (C5).
mediacore_integrations_health_probe_seconds	histogram	adapter,kind
mediacore_integrations_health_status	gauge	instance,kind
mediacore_integrations_instances	gauge	adapter,kind,status
mediacore_integrations_swaps_total	counter	instance,kind
