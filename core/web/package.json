{
  "name": "mediacore-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @mediacore/api-client",
    "typecheck": "npm run typecheck -w @mediacore/api-client",
    "lint": "eslint .",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "30.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "typescript-eslint": {
      "minimatch": "^11.0.1"
    }
  }
}
