{
  "name": "mediacore-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "../examples/hello/web"
  ],
  "scripts": {
    "build": "npm run build -w @mediacore/api-client -w @mediacore/ui-kit -w @mediacore/shell",
    "typecheck": "npm run typecheck -w @mediacore/api-client -w @mediacore/ui-kit -w @mediacore/shell -w hello-web",
    "lint": "eslint .",
    "test": "vitest",
    "check-singletons": "node scripts/check-singletons.mjs",
    "test:presets": "node --test scripts/presets.test.mjs scripts/check-singletons.test.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.3.1",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "jsdom": "30.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "typescript-eslint": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-import-x": {
      "minimatch": "^11.0.1"
    }
  }
}
