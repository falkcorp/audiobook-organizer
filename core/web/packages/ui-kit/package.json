{
  "name": "@mediacore/ui-kit",
  "version": "0.1.0",
  "description": "The mediacore theme factory and presentational components",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "vite build && node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  }
}
