{
  "name": "@mediacore/shell",
  "version": "0.1.0",
  "description": "The mediacore app shell: createShell, defineModule, auth, realtime and the vite presets",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "vite"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/index.tsx",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing.js"
    },
    "./vite": {
      "types": "./vite/index.d.mts",
      "default": "./vite/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "vite build && node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@mediacore/api-client": "0.1.0",
    "@mediacore/ui-kit": "0.1.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.3.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "vite": "^8.3.5"
  }
}
