{
  "openapi": "3.1.0",
  "info": { "title": "batcave", "version": "0.1.0" },
  "paths": {
    "/api/core/v1/batcave/login": {
      "post": {
        "operationId": "loginToBatcave",
        "x-mediacore-permission": "public",
        "responses": { "204": { "description": "signed in" } }
      }
    },
    "/api/core/v1/batcave/gadgets/{gadgetId}": {
      "get": {
        "operationId": "getGadget",
        "x-mediacore-permission": "batcave.gadgets.read",
        "parameters": [{ "name": "gadgetId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "the gadget" } }
      },
      "delete": {
        "operationId": "scrapGadget",
        "x-mediacore-permission": "batcave.gadgets.write",
        "parameters": [{ "name": "gadgetId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "scrapped" } }
      }
    },
    "/api/core/v1/batcave/signal": {
      "get": {
        "x-mediacore-permission": "authenticated",
        "responses": { "200": { "description": "the signal" } }
      }
    }
  },
  "components": { "schemas": {} }
}
