{
  "name": "@mediacore/api-client",
  "version": "0.1.0",
  "description": "The mediacore fetch runtime and the client generated from core's OpenAPI document",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "generator"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "generate": "node generator/cli.ts generate",
    "generate:check": "node generator/cli.ts check",
    "test": "vitest",
    "test:client-coverage": "vitest run test/client-coverage.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
