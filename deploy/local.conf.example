# file: deploy/local.conf.example
# version: 1.6.0
# guid: b3c5d7e9-f1a3-4b5c-9d7e-1f3a5b7c9d1e
# last-edited: 2026-11-09
#
# TEMPLATE — the environment drop-in for audiobook-organizer.service.
# Copy to deploy/local.conf (gitignored) and fill in your own endpoints.
# `make deploy` uploads it and the root-owned install-staged helper renders
# /etc/systemd/system/audiobook-organizer.service.d/local.conf from its
# [Service] and Environment= lines, one KEY=value assignment per line
# (unquoted with no spaces, or wholly in double or single quotes, no
# backslash). Any other setting refuses the deploy: systemd reads this file
# as root, so whoever writes it could otherwise write User=root or
# ExecStartPre=. The host's other settings (the ExecStart= command line with
# its TLS and DB paths, WorkingDirectory=, MemoryMax=, ...) go in
# host.conf beside it, which the owner installs as root and deploy never
# touches; the commented block below shows them.
#
# See deploy/audiobook-organizer.service for the base unit this overrides,
# and docs/system/deploy-and-gpu-ops.md for the full deploy/rollback flow.
#
# Real secrets/paths (TLS cert/key paths, actual DB path, real
# WHISPER_REMOTE_URL host if different from your own GPU box) must be filled
# in by the operator — nothing below is a real credential. 192.168.0.10 /
# 192.168.0.20 are placeholder addresses — substitute your own hosts in
# docs/system/runbooks.md and docs/status/2026-07-02-local-cutover-and-matching.md.

# --- host.conf, NOT this file -------------------------------------------
# /etc/systemd/system/audiobook-organizer.service.d/host.conf, written once
# by the owner as root (sudo tee / sudoedit), then
# `sudo systemctl daemon-reload`. `install-staged local-conf` refuses to
# deploy without it, and refuses a host.conf that runs anything but the
# service user's ExecStart (no other Exec*= line, no + or ! prefix, no
# PermissionsStartOnly=, AmbientCapabilities= or other User=/Group=):
#
# [Service]
# # Clear the base unit's ExecStart, then set the full production command line.
# ExecStart=
# ExecStart=/usr/local/bin/audiobook-organizer serve --host 0.0.0.0 --port 8484 \
#       --db /path/to/audiobooks.pebble \
#       --tls-cert /path/to/server.crt --tls-key /path/to/server.key \
#       --http3-port 8484
# # Leave TimeoutStopSec= unset unless you need more than the base unit's
# # 60 s, which covers the kernel's shutdown budget (25 s by default), the
# # store's close after it (up to 10 s for a Pebble access still in flight)
# # and a rollback's previous release (see deploy/audiobook-organizer.service).
# # Never set it lower. Production raises it to 90 s for large in-flight
# # operations (fingerprint rescans, dedup purges):
# TimeoutStopSec=90
# --------------------------------------------------------------------------

[Service]

# Point at your own Windows GPU box (or other Ollama-compatible endpoint)
# running bge-m3 (1024-dim embeddings) and qwen2.5:7b-instruct. See
# scripts/manage-ollama-windows.py for keeping that box's Ollama instance
# alive.
Environment=WHISPER_REMOTE_URL=http://192.168.0.20:8000
Environment=OLLAMA_BASE_URL=http://192.168.0.20:11434/v1

# Who may open a connection to this origin. The listener binds every interface,
# so without this any peer that can route to the port is answered. List the
# networks that should reach it directly (the LAN, which also covers this
# host's own LAN address, and a Prometheus scraper) as comma-separated CIDRs or
# bare addresses. Loopback and every address in TUNNEL_CONNECTOR_ADDRS are
# always allowed; everything else gets 403 before routing. Unset allows every
# peer and logs a startup warning. An entry that cannot be parsed stops the
# service starting. 192.0.2.0/24 is a placeholder.
#Environment=ALLOWED_PEER_CIDRS=192.0.2.0/24
#Environment=TUNNEL_CONNECTOR_ADDRS=192.0.2.10,192.0.2.11

# Password logins admitted while the login failure ceilings are spent each cost
# an argon2id derivation (a name that does not exist too), so they are admitted
# at a service-wide rate: LOGIN_SATURATED_RATE logins per second (0.01 to
# 50; default 2) with a burst of LOGIN_SATURATED_BURST (1 to 200; default
# 8). Beyond it a login is answered 429 with Retry-After. Cloudflare Access
# logins are not counted (they still run the password check, under the
# per-visitor throttle). An unusable value stops the service starting.
#Environment=LOGIN_SATURATED_RATE=2
#Environment=LOGIN_SATURATED_BURST=8
