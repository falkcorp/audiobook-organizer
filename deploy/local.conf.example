# file: deploy/local.conf.example
# version: 1.8.0
# guid: b3c5d7e9-f1a3-4b5c-9d7e-1f3a5b7c9d1e
# last-edited: 2026-11-18
#
# TEMPLATE — the environment drop-in for audiobook-organizer.service.
# Copy to deploy/local.conf (gitignored) and fill in your own endpoints.
# `make deploy` uploads it and the root-owned install-staged helper renders
# /etc/systemd/system/audiobook-organizer.service.d/local.conf from its
# [Service] and Environment= lines, one KEY=value assignment per line
# (unquoted with no spaces, or wholly in double or single quotes, no
# backslash). Any other setting refuses the deploy: systemd reads this file
# as root, so whoever writes it could otherwise write User=root or
# ExecStartPre=. The host's other settings (the ExecStart= command line with
# its TLS and DB paths, WorkingDirectory=, MemoryMax=, ...) go in
# host.conf beside it, which the owner installs as root and deploy never
# touches; the commented block below shows them.
#
# See deploy/audiobook-organizer.service for the base unit this overrides,
# and docs/system/deploy-and-gpu-ops.md for the full deploy/rollback flow.
#
# Real secrets/paths (TLS cert/key paths, actual DB path, real
# WHISPER_REMOTE_URL host if different from your own GPU box) must be filled
# in by the operator — nothing below is a real credential. 192.168.0.10 /
# 192.168.0.20 are placeholder addresses — substitute your own hosts in
# docs/system/runbooks.md and docs/status/2026-07-02-local-cutover-and-matching.md.

# --- host.conf, NOT this file -------------------------------------------
# The ExecStart= override, WorkingDirectory=, MemoryMax= and TimeoutStopSec=
# live in /etc/systemd/system/audiobook-organizer.service.d/host.conf, which
# the owner installs as root, not in this file. Write deploy/host.conf (copy
# deploy/host.conf.example, gitignored, and fill in this host's values), then
# on the deploy host run `make install-host-conf` (a dry run that checks it and
# shows the diff) and `make install-host-conf APPLY=1` (installs it and
# daemon-reloads, never restarts). `install-staged unit` and
# `local-conf` refuse to deploy without it, and refuse a host.conf that runs
# anything but the service user's ExecStart (no other Exec*= line, no + or !
# prefix, no PermissionsStartOnly=, AmbientCapabilities= or other User=/Group=);
# the install target runs the same check first.
# --------------------------------------------------------------------------

[Service]

# Every name below is a canonical ABO_<PATH> name; the names this file used
# before are retired and no longer read. A key that holds a list takes JSON,
# wholly inside single quotes on its line (the deploy helper refuses a double
# quote or a space in an unquoted value).
#
# Point at your own Windows GPU box running the whisper service. The Ollama
# endpoint (bge-m3 embeddings, qwen2.5:7b-instruct) is an AI endpoint set in
# Settings, not an environment variable. See scripts/manage-ollama-windows.py
# for keeping that box's Ollama instance alive.
Environment=ABO_BOOKS_WHISPER_REMOTE_URL=http://192.168.0.20:8000

# Who may open a connection to this origin. The listener binds every interface,
# so without this any peer that can route to the port is answered. List the
# networks that should reach it directly (the LAN, which also covers this
# host's own LAN address, and a Prometheus scraper) as comma-separated CIDRs or
# bare addresses, as a JSON array. Loopback and every address in
# ABO_CORE_HTTP_TRUSTED_PROXIES are always allowed; everything else gets 403
# before routing. Unset allows every peer and logs a startup warning. An entry
# that cannot be parsed stops the service starting. 192.0.2.0/24 is a
# placeholder.
#Environment='ABO_CORE_HTTP_PEER_ALLOWLIST=["192.0.2.0/24"]'
#Environment='ABO_CORE_HTTP_TRUSTED_PROXIES=["192.0.2.10","192.0.2.11"]'

# Password logins admitted while the login failure ceilings are spent each cost
# an argon2id derivation (a name that does not exist too), so they are admitted
# at a service-wide rate: ABO_CORE_AUTH_LOGIN_SATURATED_RATE logins per second
# (0.01 to 50; default 2) with a burst of ABO_CORE_AUTH_LOGIN_SATURATED_BURST
# (1 to 200; default 8). Beyond it a login is answered 429 with Retry-After.
# Cloudflare Access logins are not counted (they still run the password check,
# under the per-visitor throttle). An unusable value stops the service starting.
#Environment=ABO_CORE_AUTH_LOGIN_SATURATED_RATE=2
#Environment=ABO_CORE_AUTH_LOGIN_SATURATED_BURST=8
