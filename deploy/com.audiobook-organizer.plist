<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- file: deploy/com.jdfalk.audiobook-organizer.plist -->
<!-- version: 2.0.1 -->
<!-- guid: 1f2e3d4c-5b6a-4789-90ab-cdef12345678 -->
<!--
  macOS launchd plist for audiobook-organizer

  Installation:
    1. Edit this file and set AUDIOBOOK_ROOT_DIR to your library path
    2. Copy to: ~/Library/LaunchAgents/com.jdfalk.audiobook-organizer.plist
    3. Load: launchctl load ~/Library/LaunchAgents/com.jdfalk.audiobook-organizer.plist
    4. Verify: launchctl list | grep audiobook-organizer

  Management:
    launchctl unload ~/Library/LaunchAgents/com.jdfalk.audiobook-organizer.plist
    launchctl start com.jdfalk.audiobook-organizer
    launchctl stop com.jdfalk.audiobook-organizer

  Logs:
    tail -f ~/Library/Logs/audiobook-organizer.log
    tail -f ~/Library/Logs/audiobook-organizer.err
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jdfalk.audiobook-organizer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/audiobook-organizer</string>
        <string>serve</string>
    </array>

    <!-- Environment variables (edit AUDIOBOOK_ROOT_DIR for your setup) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>AUDIOBOOK_ROOT_DIR</key>
        <string>/Users/USERNAME/Audiobooks</string>
        <key>DATABASE_PATH</key>
        <string>/Users/USERNAME/.audiobook-organizer/db</string>
    </dict>

    <!-- Working directory for relative paths -->
    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/.audiobook-organizer</string>

    <!-- Start at login and restart on failure -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Stop timeout: core's 25 s shutdown budget must finish first (05-health §5H.4) -->
    <key>ExitTimeOut</key>
    <integer>60</integer>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/audiobook-organizer.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/audiobook-organizer.err</string>

    <!-- Prevent multiple instances -->
    <key>Umask</key>
    <integer>0077</integer>
</dict>
</plist>
