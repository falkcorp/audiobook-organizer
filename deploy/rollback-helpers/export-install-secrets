# export-install-secrets (no arguments), as root: the install's .encryption_key and config.yaml,
# handed to the deploy user as files in export_dir; the service-user work runs
# as the service user in a transient unit.
# A sudoers-granted stub: it runs one fixed operation of rollback_helper.py,
# which validates every argument itself (docs/system/deploy-and-gpu-ops.md,
# "Rollback helpers"). Install root-owned, mode 0755, in
# /usr/local/libexec/audiobook-organizer/rollback/.
exec /usr/bin/python3 -I /usr/local/libexec/audiobook-organizer/rollback/rollback_helper.py export-install-secrets "$@"
