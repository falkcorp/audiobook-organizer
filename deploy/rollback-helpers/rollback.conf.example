# file: deploy/rollback-helpers/rollback.conf.example
# version: 1.3.0
# guid: 8bafb640-d659-4122-8365-282864483ab6
# last-edited: 2026-11-09
#
# /etc/audiobook-organizer/rollback.conf: the fixed paths the rollback helpers
# use, make deploy's included. Root-owned, mode 0644, in a root-owned
# directory not writable by group or others. The deploy user cannot change any of these: it can only ask the
# helpers to act on them. make rollback and make rollback-restore read this
# file (it holds no secret) and refuse when bin, db or unit differ from
# DEPLOY_BIN, DEPLOY_DB or DEPLOY_UNIT.
bin = /usr/local/bin/audiobook-organizer
db = /path/to/audiobooks.pebble
state_dir = /var/lib/audiobook-organizer
unit = audiobook-organizer.service
# The unit's User=. It must own state_dir: storage restore-offline refuses
# every write, --into included, under any other user.
service_user = audiobook
# The directory make rollback-restore ROLLBACK_ARCHIVE=<name> reads archives from.
archive_dir = /path/to/archives
# core.storage.checkpoint_dir, if set; empty means the store's parent directory.
checkpoint_dir =
# The environment storage restore-offline runs with (the unit's).
offline_env = HOME=/var/lib/audiobook-organizer ABK_STATE_DIR=/var/lib/audiobook-organizer
# The unit's Group=, if not service_user. install-staged unit refuses a unit
# whose User= or Group= differ from these.
service_group =
# Where make deploy uploads the binary and local.conf (scp, as the deploy
# user); install-staged binary|local-conf installs from these. The unit is
# not uploaded: install-staged unit installs the copy of
# deploy/audiobook-organizer.service installed with the helpers.
stage_bin = /home/USER/audiobook-organizer
stage_local_conf = /home/USER/audiobook-organizer-local.conf
